rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Кожен гравець бачить і змінює лише власний рекорд
    match /players/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.stars is int
        && request.resource.data.stars >= 0 && request.resource.data.stars <= 12
        && request.resource.data.time is number
        && request.resource.data.time > 0
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 40;
      allow delete: if false;
    }
  }
}
